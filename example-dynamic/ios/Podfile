# Bare RN dynamic-frameworks harness for react-native-coverage.
# Expo cannot host this cell: React-Core is force-static under Expo, so
# Coverage*/CoverageFixture cannot be restored as dynamic frameworks.
# Primary multi-image LINKEDIT proof lives here (USE_FRAMEWORKS=dynamic).

require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require_relative '../../cocoapods/coverage_post_install'

# New Architecture required for TurboModule Coverage / CoverageFixture.
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Always dynamic for this harness (CI sets USE_FRAMEWORKS=dynamic too).
linkage = ENV['USE_FRAMEWORKS'] || 'dynamic'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'CoverageDynamic' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  ReactNativeCoverage.install_installer_hooks!(
    force_dynamic_frameworks: true
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    ReactNativeCoverage.apply_post_install!(
      installer,
      framework_name_prefixes: ['CoverageFixture'],
      force_dynamic_frameworks: true
    )
  end
end
