{
  "name": "react-native-coverage-example-dynamic",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "pod:install": "cd ios && USE_FRAMEWORKS=dynamic RCT_NEW_ARCH_ENABLED=1 bundle exec pod install",
    "ios:build": "xcodebuild -workspace ios/CoverageDynamic.xcworkspace -scheme CoverageDynamic -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "coverage-fixture": "workspace:*",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-coverage": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^7.29.14",
    "@babel/runtime": "^7.29.14",
    "@react-native-community/cli": "21.0.0",
    "@react-native-community/cli-platform-android": "21.0.0",
    "@react-native-community/cli-platform-ios": "21.0.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
