  nativeModuleName: 'Coverage',
  app: {
    androidApplicationId: 'com.example.coverage',
    iosBundleId: 'com.example.coverage',
    iosProductName: 'CoverageExample',
  },
  ios: {
    // e.g. ['MyLib'] to include MyLib*.framework as llvm-cov objects
