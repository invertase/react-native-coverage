  sourcePathRewrite: [
    { kind: 'after-marker', marker: '/packages/', includeMarker: true },
    {
      kind: 'regex',
      pattern: '^.*/@example-scope/([^/]+)/(.+)$',
      replacement: 'packages/$1/$2',
    },
